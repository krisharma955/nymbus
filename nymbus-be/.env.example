# =============================================================================
# NYMBUS BACKEND ENVIRONMENT CONFIGURATION
# Copy this file to .env in the nymbus-be directory or set them in your environment.
# =============================================================================

# --- Database (PostgreSQL with pgvector) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nymbus

# --- AI & LLM Provider (OpenRouter or OpenAI) ---
# Paste your API key here (OpenRouter recommended by schema.md)
OPENAI_API_KEY=your_openrouter_or_openai_api_key_here
OPENAI_BASE_URL=https://openrouter.ai/api/v1
CHAT_MODEL=anthropic/claude-3.5-sonnet

# --- Web Search Tool (Tavily) ---
# Obtain from https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# --- Workflow Execution Defaults ---
MAX_CONCURRENT_SUBTASKS=3
MAX_RETRIES=2

# --- Optional: Cloudflare R2 / S3 Object Storage for RAG Documents ---
# Leave empty to automatically use local fallback: data/uploads
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=nymbus-documents
